{
  "name": "rakan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-db.mjs",
    "db:link": "supabase link --project-ref",
    "db:which": "node scripts/linked-project.mjs",
    "db:migrations": "node scripts/linked-project.mjs && supabase migration list --linked",
    "db:push": "node scripts/linked-project.mjs && supabase db push --linked",
    "db:reset": "node scripts/linked-project.mjs --dev-only && supabase db reset --linked && node scripts/seed.mjs",
    "functions:deploy": "node scripts/linked-project.mjs && supabase functions deploy --use-api",
    "db:seed": "node scripts/linked-project.mjs --dev-only && node scripts/seed.mjs",
    "notify:setup": "node scripts/linked-project.mjs --dev-only && node scripts/setup-notify-secrets.mjs",
    "make:test-policies": "node scripts/make-test-policies.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "pdf-lib": "1.17.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
