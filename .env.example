# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# No local Docker database: these point at the cloud DEV project "rakan-hr".
# The production project (rakan-hr-prod) is only configured at build step 18, in Vercel.

# Dashboard > Project Settings > Data API > "Project URL" (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Dashboard > Project Settings > API Keys > "Publishable key" (sb_publishable_…)
# or the legacy "anon public" key (eyJ…). Safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET. Used only by `npm run test:db` (pgTAP tests); never exposed to the browser.
# Dashboard > Connect (top bar) > "Session pooler" URI, with [YOUR-PASSWORD] replaced by the DB password.
SUPABASE_DB_URL=

# SECRET. Resend (resend.com) > API Keys. Used only by the send-notification-email Edge Function;
# copied to Supabase by `npm run notify:setup`. Never exposed to the browser.
RESEND_API_KEY=

# Sender for notification emails, on your Resend-verified domain, e.g. Rakan <hello@yourdomain.my>.
# Empty = Resend test sender (delivers only to your own Resend account email).
EMAIL_FROM=

# Where links in notification emails point. Empty = http://localhost:3002
APP_URL=
